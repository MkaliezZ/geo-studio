{
  "name": "geo-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first cross-platform GEO workbench",
  "author": "GEO Studio contributors",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "tsx scripts/preview.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "components": "tsx scripts/components.ts",
    "package": "node scripts/licenses.mjs && npm run build && electron-builder --publish never",
    "package:dir": "node scripts/licenses.mjs && npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4",
    "diff": "^8.0.2",
    "zod": "^4.1.12",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.25.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "org.geostudio.desktop",
    "productName": "GEO Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
